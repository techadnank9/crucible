# Copy to .env.local and fill in. Never commit .env.local.
# Both are SERVER-ONLY. No NEXT_PUBLIC_ prefix — the browser must never see these.

# Base URL of your deployed CrewAI crew (no trailing slash).
CREW_URL=https://your-crew-id.crewai.com

# Bearer token from the CrewAI deployment page.
CREW_TOKEN=your-bearer-token-here
